{
  "name": "commas",
  "version": "0.39.4",
  "productName": "Commas",
  "author": "CyanSalt",
  "description": "A hackable terminal and command runner.",
  "main": "dist/main/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "postinstall": "electron-rebuild",
    "dev": "node build/build-git.mjs && electron .",
    "dev:all": "node build/build.mjs && electron .",
    "dev:user": "node build/build-user.mjs && electron .",
    "build": "node build/build.mjs && node build/pack.mjs -- --local",
    "pack": "node build/build.mjs && node build/pack.mjs",
    "release": "release-it",
    "lint:script": "eslint --cache --fix './**/*.{cjs,js,mjs,ts,vue}'",
    "lint:style": "stylelint --ignore-path .gitignore --cache --fix ./**/*.{css,scss,vue}",
    "lint": "pnpm run lint:script && pnpm run lint:style",
    "typecheck": "vue-tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyanSalt/commas.git"
  },
  "bugs": {
    "url": "https://github.com/CyanSalt/commas/issues"
  },
  "homepage": "https://github.com/CyanSalt/commas#readme",
  "license": "ISC",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "error"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@commas/api": "workspace:*",
    "@commas/electron-ipc": "workspace:*",
    "@commas/types": "workspace:*",
    "@cyansalt/eslint-config": "^4.6.0",
    "@cyansalt/stylelint-config": "^4.4.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@electron/packager": "^20.0.0",
    "@electron/rebuild": "^4.0.4",
    "@pnpm/workspace.find-packages": "^1000.0.65",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/fuzzaldrin-plus": "^0.6.5",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.3",
    "@types/node-ipc": "^9.2.3",
    "@types/shell-quote": "^1.7.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue-macros/reactivity-transform": "3.1.2",
    "@vueuse/core": "^14.3.0",
    "@withfig/autocomplete-types": "^1.31.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "css-font-face-src": "^2.1.0",
    "electron": "^42.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "fuzzaldrin-plus": "^0.6.0",
    "keyboardevent-from-electron-accelerator": "^2.0.0",
    "lucide-static": "^1.14.0",
    "png2icons": "^2.0.1",
    "release-it": "^20.0.1",
    "sass-embedded": "^1.99.0",
    "simple-icons-font": "^16.18.1",
    "stylelint": "^17.11.0",
    "type-fest": "^5.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.11",
    "vue-tsc": "^3.2.8",
    "vue-virtual-scroller": "2.0.0-beta.8"
  },
  "dependencies": {
    "@achrinza/node-ipc": "^10.1.11",
    "@fig/autocomplete-generators": "^2.4.0",
    "@vscode/sudo-prompt": "^9.3.2",
    "@vue/reactivity": "^3.5.34",
    "@withfig/autocomplete": "^2.692.3",
    "address": "^2.0.3",
    "chokidar": "^5.0.0",
    "colord": "^2.9.3",
    "file-icon": "^6.0.0",
    "lodash": "^4.18.1",
    "properties": "^1.2.1",
    "semver": "^7.7.4",
    "shell-history": "^2.0.1",
    "shell-quote": "^1.9.0",
    "unused-filename": "^4.0.1",
    "vue": "^3.5.34",
    "yaml": "^2.8.4",
    "zigpty": "^0.1.6"
  },
  "optionalDependencies": {
    "electron-clipboard-ex": "^1.3.3"
  },
  "commas:i18n": {
    "zh-CN": {
      "description": "一款可定制终端和命令执行工具"
    }
  }
}
